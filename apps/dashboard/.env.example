# Kovalio Dashboard — local dev. Copy to `.env`; `dev` loads it (node --env-file=.env).
# Non-secret runtime config: the mode lives HERE, not in a wrapper script.
# KOVALIO_TARGET selects the runtime-target row in packages/core/runtime-config.ts.
KOVALIO_TARGET=local
KOVALIO_CLOUD_TARGET=local-saas
PORT=3001
NEXT_DIST_DIR=.next

# Optional self-hosted asset host. Cloud uses the CDN with bundled /icons as a fallback.
# OPENSHIP_ICON_BASE_URL=https://cdn.oblien.com/static/png-icons
